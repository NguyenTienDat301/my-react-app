{  "unit": [    {      "id": 1,      "name": "Đại đội bộ"    },    {      "id": 2,      "name": "Trung đội 1"    },    {      "id": 3,      "name": "Trung đội 2"    }  ],  "weeks": [    {      "id": 1,      "date": "2026-07-24",      "title": "Thi đua tuần 30"    },    {      "id": 2,      "date": "2026-07-31",      "title": "Thi đua tuần 31"    },    {      "id": 3,      "date": "2026-07-30",      "title": "Thi đua tuần 3"    },    {      "id": 4,      "date": "2026-07-22",      "title": "Thi đua tuần 4"    },    {      "id": 5,      "date": "2026-07-29",      "title": "Thi đua tuần 5"    },    {      "id": 6,      "date": "2026-08-07",      "title": "Thi đua tuần 32"    },    {      "id": 7,      "date": "2026-08-14",      "title": "Thi đua tuần 33"    },    {      "id": 8,      "date": "2026-08-21",      "title": "Thi đua tuần 34"    },    {      "id": 9,      "date": "2026-08-03",      "title": "Thi đua tuần 9"    },    {      "id": 10,      "date": "2026-08-04",      "title": "Thi đua tuần 10"    },    {      "id": 11,      "date": "2026-08-05",      "title": "Thi đua tuần 11"    },    {      "id": 12,      "date": "2026-08-06",      "title": "Thi đua tuần 12"    }  ],  "scores": [    {      "id": 1,      "weekId": 1,      "unit": "Đại đội bộ",      "quanSo": 8.5,      "hocTap": 8.8,      "tacPhong": 8.4,      "kyLuat": 8.9,      "noiVu": 8.3,      "tangGia": 8.6,      "vkTrangBi": 8.8    }  ],  "masterSoldiers": [    { "id": 1001, "unit": "Đại đội bộ", "name": "Nguyễn Văn B" }  ],  "comments": [],  "soldiers": [],  "teachings": [    {      "id": 1,      "content": "Nhiệm vụ nào cũng hoàn thành, khó khăn nào cũng vượt qua, kẻ thù nào cũng đánh thắng."    },    {      "id": 2,      "content": "Trung với nước, hiếu với dân."    },    {      "id": 3,      "content": "Đoàn kết, đoàn kết, đại đoàn kết."    },    {      "id": 4,      "content": "Thi đua là yêu nước, yêu nước thì phải thi đua."    },    {      "id": 5,      "content": "Cần, kiệm, liêm, chính, chí công vô tư."    }  ],  "questions": [    {      "id": 1,      "content": "Theo Luật Nghĩa vụ quân sự, công dân đủ bao nhiêu tuổi phải đăng ký nghĩa vụ quân sự lần đầu?"    },    {      "id": 2,      "content": "Theo Luật Nghĩa vụ quân sự, thời hạn phục vụ tại ngũ trong thời bình là bao nhiêu tháng?"    },    {      "id": 3,      "content": "Theo Điều lệnh Quản lý bộ đội, quân nhân phải thực hiện mấy chế độ trong ngày?"    },    {      "id": 4,      "content": "Ngày thành lập Quân đội nhân dân Việt Nam là ngày nào?"    }  ],  "flowers": {},  "board": {},  "contents": []}